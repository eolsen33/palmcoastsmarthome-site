# seo-kit: canonical host — send the bare domain to www
RewriteEngine On
RewriteCond %{HTTP_HOST} ^palmcoastsmarthome\.com$ [NC]
RewriteRule ^ https://www.palmcoastsmarthome.com%{REQUEST_URI} [R=301,L]
# /seo-kit

# --- Security headers (weekly-audit hardening 2026-08-24) ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Never serve dotfiles (.DS_Store etc.) ---
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- No-cache HTML (Hostinger 7-day cache workaround) ---
<IfModule mod_headers.c>
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# seo-kit: crawler files must never sit in a CDN edge — they change with every deploy
<IfModule mod_headers.c>
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# /seo-kit

# Keep repo docs and tooling off the web (Hostinger deploys the whole repo).
# Added by the 2026-09-14 weekly site check: /README.md was publicly served.
RedirectMatch 404 ^/[^/]*\.md$
RedirectMatch 404 ^/(_build|_private|_pocketbase|tools|\.impeccable|\.git|\.github)(/|$)
RedirectMatch 404 ^/\.(gitignore|env|DS_Store)
